    },
    {
      "entityName": "얼룩 고양이",
      "category": "appearance",
      "content": "노란색 눈을 가졌다.",
      "quote": null,
      "sceneId": "S0003"
    },
    {
      "entityName": "얼룩 고양이",
      "category": "personality",
      "content": "자신이 영역이라고 생각하는 곳에 다른 고양이가 오는 것을 경계한다.",
