    },
    {
      "entityName": "얼룩 고양이",
      "category": "personality",
      "content": "경계하는 톤으로 말한다.",
      "quote": "여기 내 쪽이야.",
      "sceneId": "S0003"
    },
    {
      "entityName": "나",
      "category": "appearance",
      "content": "골판지 상자에서 잠을 잔다.",
      "quote": null,
      "sceneId": "S0006"
    },
    {
      "entityName": "나",
      "category": "personality",
      "content": "멍하니 앉아 생각을 많이 하는 편이다.",
      "quote": null,
      "sceneId": "S0006"
    },
    {
      "entityName": "나",
      "category": "personality",
      "content": "현재의 삶에 만족하지 못하고, 자신의 자리에 대한 소속감을 느끼지 못한다.",
      "quote": null,
      "sceneId": "S0007"
    },
    {
      "entityName": "나",
      "category": "motivation",
      "content": "저녁에 쓰레기통에서 먹을 것을 찾는 것을 목표로 한다.",
      "quote": null,
      "sceneId": "S0007"
    },
    {
      "entityName": "검은 고양이",
      "category": "appearance",
      "content": "털이 짧고 검은 고양이다.",
      "quote": null,
      "sceneId": "S0006"
    },
    {
      "entityName": "검은 고양이",
      "category": "appearance",
      "content": "눈이 노란색이다.",
      "quote": null,
      "sceneId": "S0006"
    },
    {
      "entityName": "검은 고양이",
      "category": "personality",
      "content": "나보다 움직임이 빠르다.",
      "quote": null,
      "sceneId": "S0006"
    },
    {
      "entityName": "검은 고양이",
      "category": "personality",
      "content": "현실적이고 단순한 성격이다.",
      "quote": null,
      "sceneId": "S0007"
    },
    {
      "entityName": "검은 고양이",
      "category": "personality",
      "content": "핀잔조의 말투를 사용한다.",
      "quote": "또 생각이야?",
      "sceneId": "S0006"
    },
    {
      "entityName": "검은 고양이",
      "category": "personality",
      "content": "항상 맞는 말만 한다.",
      "quote": null,
      "sceneId": "S0006"
    },
    {
      "entityName": "나",
      "category": "background",
      "content": "쓰레기통을 뒤지며 먹을 것을 찾는 고양이.",
      "quote": null,
      "sceneId": "S0008"
    },
    {
      "entityName": "나",
      "category": "motivation",
      "content": "배고픔을 해결하고 안전한 잠자리를 찾는 것이 목표다.",
      "quote": null,
      "sceneId": "S0008"
    },
    {
      "entityName": "검은 고양이",
      "category": "personality",
      "content": "쓰레기통 근처에서 '나'와 마주치는 것을 개의치 않아한다.",
      "quote": "*왔네.*",
      "sceneId": "S0008"
    },
    {
      "entityName": "검은 고양이",
      "category": "lore",
      "content": "골목 고양이들 사이에는 큰 박스에 들어가면 다른 곳으로 간다는 소문이 있다.",
      "quote": "*들어가면 다른 곳으로 간다고.*",
      "sceneId": "S0008"
    },
    {
      "entityName": "나",
      "category": "personality",
      "content": "소문에 대해 믿지 않으면서도 궁금해한다.",
      "quote": null,
      "sceneId": "S0008"
    },
    {
      "entityName": "나",
      "category": "ability",
      "content": "후각이 예민하여 평소에 맡던 냄새와 다른 냄새를 구별할 수 있다.",
      "quote": null,
      "sceneId": "S0008"
    },
    {
      "entityName": "나",
      "category": "appearance",
      "content": "담장 밑 웅덩이에서 물을 마실 수 있다.",
      "quote": null,
      "sceneId": "S0008"
    },
    {
      "entityName": "나",
      "category": "ability",
      "content": "박스 안에서 풀 냄새, 흙 냄새, 넓은 곳에서 나는 냄새를 맡는다.",
      "quote": null,
      "sceneId": "S0009"
    },
    {
      "entityName": "나",
      "category": "ability",
      "content": "박스 안에서 골목 소리가 멀어지는 것을 느낀다.",
      "quote": null,
      "sceneId": "S0009"
    },
    {
      "entityName": "나",
      "category": "personality",
      "content": "박스 안에서 이상하게 편안함을 느낀다.",
      "quote": null,
      "sceneId": "S0009"
    },
    {
      "entityName": "나",
      "category": "background",
      "content": "골목에서 쓰레기통을 뒤지며 생활했다.",
      "quote": null,
      "sceneId": "S0010"
    },
    {
      "entityName": "나",
      "category": "ability",
      "content": "후각으로 주변 환경을 파악할 수 있다.",
      "quote": null,
      "sceneId": "S0010"
    },
    {
      "entityName": "나",
      "category": "motivation",
      "content": "원래 살던 골목으로 돌아가고 싶어한다.",
      "quote": null,
      "sceneId": "S0010"
    },
    {
      "entityName": "나",
      "category": "personality",
      "content": "문제가 생기면 가만히 있지 않고 해결하려 한다.",
      "quote": null,
      "sceneId": "S0010"
    },
    {
      "entityName": "나",
      "category": "relationship_detail",
      "content": "검이 지금 무엇을 하고 있을지 궁금해한다.",
      "quote": null,
      "sceneId": "S0011"
    },
    {
      "entityName": "나",
      "category": "ability",
      "content": "사냥을 오랫동안 하지 않았다.",
      "quote": null,
      "sceneId": "S0011"
    },
    {
      "entityName": "나",
      "category": "appearance",
      "content": "회색 털을 가졌고, 나보다 조금 작다.",
      "quote": null,
      "sceneId": "S0011"
    },
    {
      "entityName": "나",
      "category": "appearance",
      "content": "짧은 털을 가졌고, 눈 색깔은 연한 색이다.",
      "quote": null,
      "sceneId": "S0011"
    },
    {
      "entityName": "나",
      "category": "personality",
      "content": "낯선 고양이가 다가와도 경계하지 않고 편안하게 앉아있는다.",
      "quote": null,
      "sceneId": "S0011"
    },
    {
      "entityName": "나",
      "category": "personality",
      "content": "표정을 읽기 어렵다.",
      "quote": null,
      "sceneId": "S0011"
    },
    {
      "entityName": "나",
      "category": "ability",
      "content": "말을 할 수 있다.",
      "quote": "어디서 왔어?",
      "sceneId": "S0011"
    },
    {
      "entityName": "골판지 상자",
