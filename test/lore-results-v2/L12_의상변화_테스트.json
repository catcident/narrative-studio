  "loreEntries": [
    {
      "entityName": "한소희",
      "category": "appearance",
      "content": "허리까지 오는 갈색 웨이브 머리를 하나로 묶었다.",
      "quote": null,
      "sceneId": "S0001"
    },
    {
      "entityName": "한소희",
      "category": "appearance",
      "content": "화장을 거의 하지 않은 맨얼굴이다.",
      "quote": null,
      "sceneId": "S0001"
    },
    {
      "entityName": "한소희",
      "category": "outfit",
      "content": "검은 크롭탑에 하이웨스트 청바지를 입고 있었다.",
      "quote": null,
      "sceneId": "S0001"
    },
    {
      "entityName": "최영준",
      "category": "appearance",
      "content": "짧은 머리에 날카로운 눈매를 가졌다.",
      "quote": null,
      "sceneId": "S0001"
    },
    {
      "entityName": "최영준",
      "category": "outfit",
      "content": "검은 터틀넥에 회색 슬랙스 차림이었다.",
      "quote": null,
      "sceneId": "S0001"
    },
    {
      "entityName": "최영준",
      "category": "outfit",
      "content": "왼쪽 손목에 고가의 은색 시계를 차고 있었다.",
      "quote": null,
      "sceneId": "S0001"
    },
    {
      "entityName": "최영준",
      "category": "personality",
      "content": "춤에 감정이 실려야 한다고 생각한다.",
      "quote": "동작은 좋은데 감정이 없어. 춤은 기술이 아니라 이야기야.",
      "sceneId": "S0001"
    },
    {
      "entityName": "박지유",
      "category": "appearance",
      "content": "어깨 위로 내려오는 단발머리이다.",
      "quote": null,
      "sceneId": "S0001"
    },
    {
      "entityName": "박지유",
      "category": "appearance",
      "content": "둥글둥글한 얼굴이다.",
      "quote": null,
      "sceneId": "S0001"
    },
    {
      "entityName": "박지유",
      "category": "outfit",
      "content": "흰 원피스에 분홍 카디건을 입고 있었다.",
      "quote": null,
      "sceneId": "S0001"
    },
    {
      "entityName": "한소희",
      "category": "outfit",
      "content": "회색 맨투맨에 검은 레깅스를 입는다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "한소희",
      "category": "outfit",
      "content": "낡은 흰색 운동화를 신는다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "한소희",
      "category": "appearance",
      "content": "머리는 항상 높은 포니테일로 묶는다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "한소희",
      "category": "personality",
      "content": "깔끔한 성격이다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "박지유",
      "category": "outfit",
      "content": "분홍 트레이닝복이나 보라색 후드티에 흰 반바지를 입는다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "박지유",
      "category": "appearance",
      "content": "머리를 양 갈래로 묶거나, 머리띠를 하거나, 그냥 풀거나 매번 다르게 한다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "박지유",
      "category": "personality",
      "content": "기분에 따라 옷을 입어야 춤도 잘 춘다고 생각한다.",
      "quote": "많지. 기분 따라 입어야 춤도 잘 추지.",
      "sceneId": "S0002"
    },
    {
      "entityName": "최영준",
      "category": "outfit",
      "content": "검은 가죽 재킷에 찢어진 청바지를 입었다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "최영준",
      "category": "outfit",
      "content": "날씨와 관계없이 항상 검은색 계열의 옷을 입는다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "한소희",
      "category": "outfit",
      "content": "스팽글이 달린 은색 원피스를 입었다.",
      "quote": null,
      "sceneId": "S0003"
    },
    {
      "entityName": "한소희",
      "category": "outfit",
