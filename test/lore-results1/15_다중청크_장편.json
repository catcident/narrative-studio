  "loreEntries": [
    {
      "entityName": "윤기태",
      "category": "personality",
      "content": "매일 아침 마을 입구 정자나무 아래에서 바둑을 둔다.",
      "quote": "기태야, 서울 간 아들은 잘 있냐?",
      "sceneId": "S0001"
    },
    {
      "entityName": "윤기태",
      "category": "relationship_detail",
      "content": "아들 윤용준이 서울에서 변호사로 일하는 것을 알고 있다.",
      "quote": "응. 용준이는 바빠서 못 온다더라.",
      "sceneId": "S0001"
    },
    {
      "entityName": "박순덕",
      "category": "relationship_detail",
      "content": "손녀 윤하나가 이번 방학에 오는 것을 알고 기뻐한다.",
      "quote": "정자야, 우리 하나가 이번 방학에 온다더라.",
      "sceneId": "S0001"
    },
    {
      "entityName": "윤용준",
      "category": "background",
      "content": "서울에서 변호사로 일한다.",
      "quote": null,
      "sceneId": "S0001"
    },
    {
      "entityName": "최서연",
      "category": "background",
      "content": "초등학교 교사이다.",
      "quote": null,
      "sceneId": "S0001"
    },
    {
      "entityName": "윤하나",
      "category": "relationship_detail",
      "content": "박순덕의 요리를 좋아한다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "이민규",
      "category": "relationship_detail",
      "content": "윤하나와 금방 친해졌다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "손태호",
      "category": "background",
      "content": "녹원리의 이장이다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "손태호",
      "category": "personality",
      "content": "아이들에게 뒷산 너머에 가지 말라고 경고한다.",
      "quote": null,
      "sceneId": "S0002"
    },
    {
      "entityName": "윤용준",
      "category": "motivation",
      "content": "딸 윤하나가 산에서 내려오지 않았다는 소식을 듣고 걱정한다.",
      "quote": "용준아, 하나가 산에서 안 내려와!",
      "sceneId": "S0003"
    },
    {
      "entityName": "이정자",
