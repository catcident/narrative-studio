# 프로덕션 기본값 (민감하지 않은 정보)
# 민감한 정보는 .env.local에 설정하세요
NODE_ENV=production
PORT=3000

# 인증: 기본 활성 (코드 기본값 = true)
# 비활성화하려면 AUTH_ENABLED=false 를 명시적으로 설정 (Railway 등)

# NextAuth.js (프로덕션 공개 정보)
AUTH_URL=https://storygraph.catcident.com

# Catcident OAuth (프로덕션 공개 정보)
AUTH_CATCIDENT_ISSUER=https://catcident.com

# Catcident Billing API (프로덕션 기본값)
CATCIDENT_API_URL=https://catcident.com
