# ===========================================
# 환경 변수 파일 구조
# ===========================================
# .env        - 프로덕션 기본값 (Git 커밋)
# .env.local  - 시크릿 + 로컬 오버라이드 (Git 무시)
#
# Docker Compose는 두 파일을 순서대로 로드하여
# .env.local의 값이 .env를 덮어씁니다.
# ===========================================

# ===========================================
# .env에 포함된 프로덕션 기본값 (수정 불필요)
# ===========================================
# NODE_ENV=production
# PORT=3000
# AUTH_CATCIDENT_ISSUER=https://catcident.com
# CATCIDENT_API_URL=https://catcident.com

# 인증: 코드 기본값 = true (설정 없으면 활성)
# 비활성화: AUTH_ENABLED=false (Railway 퍼블릭 데모용)

# ===========================================
# .env.local에 설정해야 할 값들
# ===========================================

# --- 시크릿 ---

# OpenRouter API Key (필수)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB 연결 (필수)
# 로컬: mongodb://localhost:27017
# Docker: mongodb://storygraph_admin:PASSWORD@mongodb:27017/character_relationship_chart?authSource=admin
MONGO_URL=mongodb://localhost:27017
MONGO_USER=storygraph_admin
MONGO_PASSWORD=your_secure_password_here

# NextAuth.js (필수)
# AUTH_SECRET 생성: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
AUTH_CATCIDENT_ID=your_oauth_client_id
AUTH_CATCIDENT_SECRET=your_oauth_client_secret

# Catcident Billing 서비스 키 (크레딧 차감용)
CATCIDENT_SERVICE_KEY=sk-svc-your_service_key_here

# --- 로컬 오버라이드 (프로덕션이면 불필요) ---

# AUTH_URL=https://storygraph.catcident.lan
# AUTH_CATCIDENT_ISSUER=https://catcident.lan
# CATCIDENT_API_URL=http://catcident-backend-api-1:8000
