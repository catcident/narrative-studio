# ===========================================
# 환경 변수 파일 구조
# ===========================================
# .env        - 프로덕션 기본값 (Git 커밋)
# .env.local  - 시크릿 + 로컬 오버라이드 (Git 무시)
#
# Docker Compose는 두 파일을 순서대로 로드하여
# .env.local의 값이 .env를 덮어씁니다.
# ===========================================

# ===========================================
# .env에 포함된 프로덕션 기본값 (수정 불필요)
# ===========================================
# NODE_ENV=production
# PORT=3000
# AUTH_CATCIDENT_ISSUER=https://catcident.com
# CATCIDENT_API_URL=https://catcident.com

# 인증: 코드 기본값 = true (설정 없으면 활성)
# 비활성화: AUTH_ENABLED=false (Railway 퍼블릭 데모용)

# AI 외부 호출은 명시적으로 활성화한 환경에서만 허용됩니다.
AI_ENABLED=false

# ===========================================
# .env.local에 설정해야 할 값들
# ===========================================

# --- 시크릿 ---

# OpenRouter API Key (AI_ENABLED=true일 때만 필요)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB 연결 (필수, replica set 또는 mongodb+srv topology)
# 로컬 replica set: mongodb://localhost:27017/character_relationship_chart?replicaSet=rs0&directConnection=true
# Docker Compose: mongodb://storygraph_admin:PASSWORD@mongodb:27017/character_relationship_chart?authSource=admin&replicaSet=rs0
MONGO_URL=mongodb://localhost:27017/character_relationship_chart?replicaSet=rs0&directConnection=true
# Docker MongoDB 초기화용 (MONGO_URL 자격증명과 일치시킬 것)
MONGO_INITDB_ROOT_USERNAME=storygraph_admin
MONGO_INITDB_ROOT_PASSWORD=your_secure_password_here
# 선택: replica set 내부 인증 key source. 미설정 시 root password에서 keyfile을 파생합니다.
MONGO_REPLICA_SET_KEY=replace_with_long_random_replica_key

# NextAuth.js (필수)
# AUTH_SECRET 생성: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
AUTH_CATCIDENT_ID=your_oauth_client_id
AUTH_CATCIDENT_SECRET=your_oauth_client_secret

# Catcident↔StoryGraph 최소권한 서비스 키 (크레딧 차감 + 내부 탈퇴 API)
# backend STORYGRAPH_SERVICE_KEY와 같은 값으로 설정하고 두 서비스를 함께 회전합니다.
CATCIDENT_SERVICE_KEY=sk-svc-your_service_key_here
# 무중단 키 회전 중에만 직전 키를 두고, backend 전환·재시도 완료 후 제거합니다.
CATCIDENT_SERVICE_KEY_PREVIOUS=
# 탈퇴 subject tombstone용 별도 HMAC pepper (필수, openssl rand -base64 48).
# 서비스 키로 재사용하거나 정기 회전하지 마세요. 분실·변경 시 기존 denylist를
# 조회할 수 없으므로 권위 있는 탈퇴 subject 목록으로 전체 tombstone을 재구축할 때만 교체합니다.
WITHDRAWAL_SUBJECT_PEPPER=replace_with_a_separate_long_random_pepper

# --- 로컬 오버라이드 (프로덕션이면 불필요) ---

# AUTH_URL=https://storygraph.catcident.lan
# AUTH_CATCIDENT_ISSUER=https://catcident.lan
# CATCIDENT_API_URL=http://catcident-backend-api-1:8000
