{
  "name": "character-relationship-chart",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:write-fences": "node ./scripts/check-user-write-fences.mjs",
    "check:security": "npm audit --omit=dev --audit-level=critical",
    "check": "npm run typecheck && npm run check:write-fences",
    "test:integration:server": "node --test tests/integration/*.test.mjs",
    "test:integration": "docker compose --env-file /dev/null -f docker-compose.integration.yml up --build --abort-on-container-exit --exit-code-from integration-tests integration-tests"
  },
  "dependencies": {
    "@sentry/nextjs": "10.70.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@xyflow/react": "^12.10.0",
    "force-graph": "^1.51.1",
    "html-to-image": "1.11.11",
    "iconv-lite": "^0.7.2",
    "jspdf": "4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.563.0",
    "mongodb": "^7.0.0",
    "next": "15.5.23",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "server-only": "^0.0.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3"
  }
}
