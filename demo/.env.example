# OpenRouter API Key (필수)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# MongoDB 연결 (Railway)
# 로컬 개발: mongodb://localhost:27017
# Railway 내부: mongodb://mongo:PASSWORD@PRIVATE_DOMAIN:27017
# Railway 외부: mongodb://mongo:PASSWORD@PUBLIC_DOMAIN:PORT
MONGO_URL=mongodb://localhost:27017
MONGO_PUBLIC_URL=
