# OpenRouter API Key (필수)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# MongoDB 연결
# 로컬 개발: mongodb://localhost:27017
# Docker Compose: mongodb://chart_admin:PASSWORD@mongodb:27017/character_relationship_chart?authSource=admin
MONGO_URL=mongodb://localhost:27017
MONGO_USER=chart_admin
MONGO_PASSWORD=your_secure_password_here

# 인증 설정
# true: OAuth 인증 활성화 (Production - Oracle Cloud)
# false 또는 미설정: 인증 비활성화 (Railway)
AUTH_ENABLED=false

# NextAuth.js 설정 (AUTH_ENABLED=true 시 필수)
# AUTH_SECRET 생성: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
AUTH_URL=http://localhost:3000

# CatCident OAuth Provider (AUTH_ENABLED=true 시 필수)
AUTH_CATCIDENT_ISSUER=https://catcident.com
AUTH_CATCIDENT_ID=your_oauth_client_id
AUTH_CATCIDENT_SECRET=
